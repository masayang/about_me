{
    "name": "Grok Chatbot Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22",
            "nodeGypDependencies": true
        }
    },
    "postCreateCommand": "curl -fsSL https://x.ai/cli/install.sh | bash",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-python.python",
                "ms-toolsai.jupyter",
                "eamodio.gitlens",
                "bruno-api-client.bruno",
                "PawelHuryn.grok-vscode-phuryn"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "typescript.tsdk": "node_modules/typescript/lib"
            }
        }
    },
    "forwardPorts": [
        3000,
        3333,
        8000
    ],
    "portsAttributes": {
        "3000": {
            "label": "App",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "API",
            "onAutoForward": "notify"
        }
    },
    "mounts": [
        // Uncomment to use host SSH keys for git remotes
        // "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "GROK_MEMORY": "1"
    }
}